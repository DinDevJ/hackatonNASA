{
  "name": "eva-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Computadora central EVA: ingesta de tramas, registro de variables, sincronizacion y modelo LUNNA",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/servidor.ts",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/simulador.ts",
    "nave": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/rol.ts nave",
    "tierra": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/rol.ts tierra",
    "certs": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/certs.ts",
    "migrar": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/migrar.ts",
    "evaluar": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/evaluar-salud.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts"
  }
}
