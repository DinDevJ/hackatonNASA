{
  "name": "monarcas-ingesta-leo",
  "version": "0.1.0",
  "private": true,
  "description": "Capa de extracción y normalización de las 78 variables de Leo (Equipo Monarcas, NASA Space Apps 2026)",
  "type": "module",
  "scripts": {
    "descargar": "tsx src/descargar.ts",
    "tipoA": "tsx src/tipoA/index.ts",
    "validar": "tsx src/validar.ts",
    "typecheck": "tsc --noEmit",
    "fuentes": "tsx src/fuentes/verificar.ts",
    "tipoB": "tsx src/tipoB/index.ts",
    "tipoC": "tsx src/tipoC/index.ts",
    "todo": "npm run descargar && npm run tipoA && npm run tipoB && npm run tipoC && npm run validar -- out/tipoA.json && npm run validar -- out/tipoB.json && npm run validar -- out/tipoC.json",
    "test:reloj": "tsx src/reloj/huawei-watch5.test.ts",
    "clasificacion": "tsx src/clasificacion.ts",
    "tabla": "tsx src/actualizar-tabla.ts",
    "reloj:build": "tsc -p tsconfig.web.json",
    "reloj": "tsc -p tsconfig.web.json && tsx src/servir.ts"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "csv-parse": "5.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "22.10.2",
    "@types/web-bluetooth": "0.0.20",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
