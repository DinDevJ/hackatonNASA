[Unit]
Description=Lunna · backend en modo simulación (landing y nginx aparte)
After=network-online.target
Wants=network-online.target

[Service]
User=lunna
Group=lunna
WorkingDirectory=__DIR__/Simulacion
# Sólo escucha en local: a internet se llega únicamente a través de nginx (límites y cabeceras).
Environment=HOST=127.0.0.1
Environment=PUERTO=__PUERTO_BACKEND__
Environment=NODE_OPTIONS=--max-old-space-size=256
# Python propio con numpy y pandas para el motor de 20 padecimientos (semáforo)
Environment=PYTHON=__PYTHON__
ExecStart=__NODE__ --experimental-strip-types --disable-warning=ExperimentalWarning ../Sistema/backend/src/servidor.ts --modo simulacion --simulacion .
Restart=always
RestartSec=3
# Para no quitarle memoria al otro proyecto del VPS (medido: ~110 MB en reposo, ~200 MB en vivo)
MemoryHigh=350M
MemoryMax=500M
# Endurecimiento: sólo escribe en su carpeta
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=__DIR__

[Install]
WantedBy=multi-user.target
